{
  "name": "react-hex-editor",
  "description": "View and edit binary data in React.",
  "version": "0.3.0",
  "license": "ISC",
  "repository": "github:sashauly/react-hex-editor",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "typings": "dist/index.d.ts",
  "packageManager": "npm@11.20.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.1"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.20.0"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.site.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run clean && vite build && tsc -p tsconfig.build.json && node scripts/finish-build.mjs",
    "start": "vite --config vite.site.config.mjs",
    "dev": "vite --config vite.site.config.mjs",
    "build:site": "vite build --config vite.site.config.mjs && typedoc",
    "preview": "vite preview --config vite.site.config.mjs --host 127.0.0.1",
    "test:browser": "playwright test",
    "check:package": "node scripts/check-package.mjs",
    "check:links": "node scripts/check-links.mjs",
    "package": "node scripts/package.mjs",
    "prepack": "npm run build",
    "validate": "npm run typecheck && npm run lint && npm test && npm run build:site && npm run check:links && npm run check:package"
  },
  "dependencies": {
    "classnames": "2.5.1",
    "keycode-js": "3.1.0",
    "keycoder": "1.1.1",
    "react-virtualized-auto-sizer": "1.0.26",
    "react-window": "1.8.11"
  },
  "peerDependencies": {
    "react": ">=16.8.6 <19",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.0.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/react-window": "1.8.8",
    "@types/styled-components": "5.1.36",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "styled-components": "5.3.11",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "files": [
    "dist",
    "themes"
  ],
  "homepage": "https://sashauly.github.io/react-hex-editor/",
  "bugs": {
    "url": "https://github.com/sashauly/react-hex-editor/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./themes": {
      "types": "./themes/index.d.ts",
      "import": "./themes/index.mjs",
      "require": "./themes/index.js"
    },
    "./themes/*.js": {
      "types": "./themes/*.d.ts",
      "import": "./themes/*.mjs",
      "require": "./themes/*.js"
    },
    "./themes/*": {
      "types": "./themes/*.d.ts",
      "import": "./themes/*.mjs",
      "require": "./themes/*.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  }
}
